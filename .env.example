APP_DEV=true
BROWSER=none
SKIP_PREFLIGHT_CHECK=true

# MongoDB Atlas connection string
MONGO_LINK=

# GitHub OAuth app credentials (register your own at https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional, defaults to http://localhost:3001/auth/github/callback
GITHUB_CALLBACK_URL=

# Google OAuth app credentials (register your own at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional, defaults to http://localhost:3001/auth/google/callback
GOOGLE_CALLBACK_URL=
